{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "color": "#F7F3EC", "name": "Warm White", "slug": "warm-white" },
        { "color": "#10233F", "name": "Night Blue", "slug": "night-blue" },
        { "color": "#173863", "name": "Deep Blue", "slug": "deep-blue" },
        { "color": "#FF7A59", "name": "Impact Coral", "slug": "impact-coral" },
        { "color": "#FFD7C9", "name": "Soft Coral", "slug": "soft-coral" },
        { "color": "#E3E9F2", "name": "Mist", "slug": "mist" },
        { "color": "#5D6C81", "name": "Steel", "slug": "steel" },
        { "color": "#FFFFFF", "name": "White", "slug": "white" }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "name": "2XS", "size": "0.5rem", "slug": "2xs" },
        { "name": "XS", "size": "0.875rem", "slug": "xs" },
        { "name": "S", "size": "1.25rem", "slug": "s" },
        { "name": "M", "size": "clamp(1.5rem, 2vw, 2rem)", "slug": "m" },
        { "name": "L", "size": "clamp(2rem, 4vw, 3.25rem)", "slug": "l" },
        { "name": "XL", "size": "clamp(3rem, 6vw, 5rem)", "slug": "xl" }
      ],
      "units": [ "%", "px", "em", "rem", "vh", "vw" ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontSizes": [
        { "slug": "xs", "size": "0.875rem", "name": "XS" },
        { "slug": "s", "size": "1rem", "name": "S" },
        { "slug": "m", "size": "1.125rem", "name": "M" },
        { "slug": "l", "size": "1.55rem", "name": "L" },
        { "slug": "xl", "size": "3rem", "name": "XL" },
        { "slug": "display", "size": "4rem", "name": "Display" }
      ],
      "fontFamilies": [
        {
          "name": "Fira Sans",
          "slug": "fira-sans",
          "fontFamily": "\"Fira Sans\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "\"Fira Sans\"",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": [ "file:./assets/fonts/fira-sans/FiraSans-Regular.woff2" ]
            },
            {
              "fontFamily": "\"Fira Sans\"",
              "fontWeight": "500",
              "fontStyle": "normal",
              "src": [ "file:./assets/fonts/fira-sans/FiraSans-Medium.woff2" ]
            },
            {
              "fontFamily": "\"Fira Sans\"",
              "fontWeight": "600",
              "fontStyle": "normal",
              "src": [ "file:./assets/fonts/fira-sans/FiraSans-SemiBold.woff2" ]
            }
          ]
        },
        {
          "name": "Literata",
          "slug": "literata",
          "fontFamily": "Literata, serif",
          "fontFace": [
            {
              "fontFamily": "Literata",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": [ "file:./assets/fonts/literata/Literata72pt-Regular.woff2" ]
            },
            {
              "fontFamily": "Literata",
              "fontWeight": "600",
              "fontStyle": "normal",
              "src": [ "file:./assets/fonts/literata/Literata72pt-SemiBold.woff2" ]
            }
          ]
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var:preset|color|warm-white",
      "text": "var:preset|color|night-blue"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "left": "max(1rem, 4vw)",
        "right": "max(1rem, 4vw)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|fira-sans",
      "fontSize": "var:preset|font-size|m",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|literata",
          "fontWeight": "600",
          "lineHeight": "1.08"
        },
        "color": {
          "text": "var:preset|color|night-blue"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|deep-blue"
        },
        "typography": {
          "textDecoration": "none"
        }
      },
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "var:preset|color|impact-coral",
          "text": "var:preset|color|night-blue"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "bottom": "0.9rem",
            "left": "1.35rem",
            "right": "1.35rem"
          }
        },
        "typography": {
          "fontWeight": "600"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|literata",
          "fontWeight": "600",
          "letterSpacing": "0"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|s",
          "fontWeight": "500"
        }
      },
      "core/post-title": {
        "typography": {
          "fontSize": "var:preset|font-size|xl"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "newsletter-landing", "title": "Newsletter Landing", "postTypes": [ "page" ] }
  ]
}
